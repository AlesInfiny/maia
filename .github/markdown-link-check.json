{
  "ignorePatterns": [
    {
      "pattern": "^#"
    },
    {
      "pattern": "^https?://localhost"
    },
    {
      "pattern": "^https?://127\\.0\\.0\\.1"
    },
    {
      "pattern": "^(\\.\\./)+downloads/.+\\.zip$"
    },
    {
      "pattern": "^https://www\\.npmjs\\.com/"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "httpHeaders": [
    {
      "urls": [
        "https://"
      ],
      "headers": {
        "User-Agent": "Mozilla/5.0 (compatible; markdown-link-check)"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [
    200,
    206
  ]
}
