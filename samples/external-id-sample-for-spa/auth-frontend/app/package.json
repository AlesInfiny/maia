{
  "name": "app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "mock": "vite --mode mock",
    "build:dev": "run-p type-check build-only:dev --print-label",
    "build:prod": "run-p type-check build-only:prod --print-label",
    "preview": "vite preview",
    "test:unit": "vitest",
    "type-check": "vue-tsc --build",
    "lint": "run-s eslint format --print-label",
    "lint:ci": "run-p eslint:ci format:ci --print-label",
    "build-only:dev": "vite build --mode dev",
    "build-only:prod": "vite build --mode prod",
    "eslint": "eslint . --fix --cache",
    "eslint:ci": "eslint . --cache",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "generate-client": "openapi-generator-cli batch ./openapisettings.json --clean",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/msal-browser": "5.6.3",
    "@vue/devtools-api": "8.2.1",
    "axios": "1.18.0",
    "pinia": "4.0.3",
    "vue": "3.5.30"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "2.40.1",
    "@pinia/testing": "2.0.1",
    "@tsconfig/node24": "24.0.4",
    "@types/jsdom": "28.0.0",
    "@types/node": "25.5.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.5.4",
    "eslint-plugin-vue": "10.11.0",
    "jiti": "2.7.0",
    "jsdom": "29.0.0",
    "msw": "2.12.12",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^24.21.0",
    "npm": "^11.19.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
