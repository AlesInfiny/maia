<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.dressca.applicationmodules.shopping.internal.infrastructure.repository.mybatis.mapper.DisplayItemCategoryQueryMapper">
  <resultMap id="displayItemCategoryResultMap" type="com.dressca.applicationmodules.shopping.entity.DisplayItemCategory">
    <id property="id" column="ID" jdbcType="OTHER" typeHandler="com.dressca.applicationmodules.shared.mybatis.UuidTypeHandler"/>
    <result property="name" column="NAME"/>
  </resultMap>

  <select id="selectAll" resultMap="displayItemCategoryResultMap">
    SELECT
      CATALOG_CATEGORIES.ID,
      CATALOG_CATEGORIES.NAME
    FROM CATALOG_CATEGORIES
  </select>

  <select id="selectById" resultMap="displayItemCategoryResultMap">
    SELECT
      CATALOG_CATEGORIES.ID,
      CATALOG_CATEGORIES.NAME
    FROM CATALOG_CATEGORIES
    WHERE CATALOG_CATEGORIES.ID = #{id,jdbcType=OTHER,typeHandler=com.dressca.applicationmodules.shared.mybatis.UuidTypeHandler}
  </select>
</mapper>
