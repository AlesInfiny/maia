<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.dressca.domainmodules.shopping.internal.infrastructure.mybatis.mapper.JoinedBasketMapper">

  <sql id="selectBasketsIncludeItem">
    SELECT
      BASKETS.ID,
      BASKETS.BUYER_ID,
      ITEMS.ID AS ITEM_ID,
      ITEMS.BASKET_ID,
      ITEMS.DISPLAY_ITEM_ID,
      ITEMS.UNIT_PRICE,
      ITEMS.QUANTITY
    FROM BASKETS
    LEFT JOIN BASKET_ITEMS AS ITEMS ON (
      BASKETS.ID = ITEMS.BASKET_ID
    )
  </sql>

  <resultMap id="basketsIncludeItemResultMap" type="com.dressca.domainmodules.shopping.basket.Basket">
    <id property="id" column="ID" jdbcType="OTHER" typeHandler="com.dressca.domainmodules.common.mybatis.handler.UuidTypeHandler"/>
    <result property="buyerId" column="BUYER_ID" jdbcType="OTHER" typeHandler="com.dressca.domainmodules.common.mybatis.handler.UuidTypeHandler"/>
    <collection property="items" ofType="com.dressca.domainmodules.shopping.basket.BasketItem" resultMap="itemsResultMap"/>
  </resultMap>

  <resultMap id="itemsResultMap" type="com.dressca.domainmodules.shopping.basket.BasketItem">
    <id property="id" column="ITEM_ID" jdbcType="OTHER" typeHandler="com.dressca.domainmodules.common.mybatis.handler.UuidTypeHandler"/>
    <result property="basketId" column="BASKET_ID" jdbcType="OTHER" typeHandler="com.dressca.domainmodules.common.mybatis.handler.UuidTypeHandler"/>
    <result property="displayItemId" column="DISPLAY_ITEM_ID" jdbcType="OTHER" typeHandler="com.dressca.domainmodules.common.mybatis.handler.UuidTypeHandler"/>
    <result property="unitPrice" column="UNIT_PRICE"/>
    <result property="quantity" column="QUANTITY"/>
  </resultMap>

  <select id="findById" resultMap="basketsIncludeItemResultMap">
    <include refid="selectBasketsIncludeItem"/>
    WHERE BASKETS.ID = #{id,jdbcType=OTHER,typeHandler=com.dressca.domainmodules.common.mybatis.handler.UuidTypeHandler}
  </select>

  <select id="findByBuyerId" resultMap="basketsIncludeItemResultMap">
    <include refid="selectBasketsIncludeItem"/>
    WHERE BASKETS.BUYER_ID = #{buyerId,jdbcType=OTHER,typeHandler=com.dressca.domainmodules.common.mybatis.handler.UuidTypeHandler}
  </select>
</mapper>
