<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.dressca.domainmodules.shopping.internal.infrastructure.repository.mybatis.mapper.DisplayItemCategoryQueryMapper">

  <!--
    カタログ管理コンテキストが所有する CATALOG_CATEGORIES を参照します。
    買い物コンテキストからは読み取りのみを行い、更新系のステートメントは定義しません。
  -->
  <resultMap id="displayItemCategoryResultMap" type="com.dressca.domainmodules.shopping.model.DisplayItemCategory">
    <id property="id" column="ID" jdbcType="OTHER" typeHandler="com.dressca.domainmodules.common.mybatis.handler.UuidTypeHandler"/>
    <result property="name" column="NAME"/>
  </resultMap>

  <select id="selectAll" resultMap="displayItemCategoryResultMap">
    SELECT
      CATALOG_CATEGORIES.ID,
      CATALOG_CATEGORIES.NAME
    FROM CATALOG_CATEGORIES
  </select>

  <select id="selectById" resultMap="displayItemCategoryResultMap">
    SELECT
      CATALOG_CATEGORIES.ID,
      CATALOG_CATEGORIES.NAME
    FROM CATALOG_CATEGORIES
    WHERE CATALOG_CATEGORIES.ID = #{id,jdbcType=OTHER,typeHandler=com.dressca.domainmodules.common.mybatis.handler.UuidTypeHandler}
  </select>
</mapper>
